{
  "name": "rpg-localization-workbench",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win portable",
    "dist:test": "electron-builder --win portable --config.extraMetadata.name=rpg-localization-workbench-test --config.productName=RPG汉化工作台-测试版 --config.directories.output=dist-test",
    "pack": "electron-builder --win dir",
    "pack:test": "electron-builder --win dir --config.extraMetadata.name=rpg-localization-workbench-test --config.productName=RPG汉化工作台-测试版 --config.directories.output=dist-test",
    "lint": "echo \"No linter configured\""
  },
  "description": "RPG Maker 汉化工作台",
  "author": "RPG Localization Workbench",
  "devDependencies": {
    "electron": "42.3.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.rpg.localization.workbench",
    "productName": "RPG汉化工作台",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "extraMetadata": {
      "name": "rpg-localization-workbench"
    }
  }
}
