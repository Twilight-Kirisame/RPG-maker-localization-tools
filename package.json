{
  "name": "rpg-localization-workbench",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "generate-icon": "python scripts/generate_icon.py assets/app-icon-source.png assets/app-icon.ico",
    "dist": "npm run generate-icon && electron-builder --win nsis",
    "dist:portable": "npm run generate-icon && electron-builder --win portable",
    "dist:test": "npm run generate-icon && electron-builder --win nsis --config.extraMetadata.name=rpg-localization-workbench-test --config.productName=RPG汉化工作台-测试版 --config.directories.output=dist-test",
    "dist:test:portable": "npm run generate-icon && electron-builder --win portable --config.extraMetadata.name=rpg-localization-workbench-test --config.productName=RPG汉化工作台-测试版 --config.directories.output=dist-test",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:mac:test": "electron-builder --mac dmg zip --config.extraMetadata.name=rpg-localization-workbench-test --config.productName=RPG汉化工作台-测试版 --config.directories.output=dist-test",
    "dist:mac:winhost": "electron-builder --mac zip --x64 --arm64",
    "dist:mac:winhost:test": "electron-builder --mac zip --x64 --arm64 --config.extraMetadata.name=rpg-localization-workbench-test --config.productName=RPG汉化工作台-测试版 --config.directories.output=dist-test",
    "pack": "npm run generate-icon && electron-builder --win dir",
    "pack:test": "npm run generate-icon && electron-builder --win dir --config.extraMetadata.name=rpg-localization-workbench-test --config.productName=RPG汉化工作台-测试版 --config.directories.output=dist-test",
    "pack:mac": "electron-builder --mac dir",
    "pack:mac:test": "electron-builder --mac dir --config.extraMetadata.name=rpg-localization-workbench-test --config.productName=RPG汉化工作台-测试版 --config.directories.output=dist-test",
    "lint": "echo \"No linter configured\""
  },
  "description": "RPG Maker 汉化工作台",
  "author": "RPG Localization Workbench",
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.rpg.localization.workbench",
    "productName": "RPG汉化工作台",
    "asar": true,
    "asarUnpack": [
      "assets/**/*.ico",
      "assets/**/*.png",
      "assets/**/*.svg"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RPG汉化工作台",
      "uninstallDisplayName": "RPG汉化工作台 ${version}",
      "installerIcon": "assets/app-icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "unicode": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false,
      "sign": false
    },
    "extraMetadata": {
      "name": "rpg-localization-workbench"
    }
  }
}
